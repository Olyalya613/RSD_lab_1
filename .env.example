# setup-env.ps1 generates .env with a private random development password.
POSTGRES_IMAGE=postgres:18.4-bookworm
PYTHON_IMAGE=python:3.12.10-slim-bookworm
APP_IMAGE=travelerapi-lab3:local
APP_PORT=4567
POSTGRES_DB=traveler_lab3
POSTGRES_USER=traveler_lab3
POSTGRES_PASSWORD=REPLACE_WITH_YOUR_PASSWORD
DATABASE_URL=postgresql://traveler_lab3:REPLACE_WITH_YOUR_PASSWORD@postgres:5432/traveler_lab3
WEB_CPUS=2.0
WEB_MEMORY=1g
DB_CPUS=2.0
DB_MEMORY=2g
